<?xml version="1.0"?>
<!-- Generated collision geometry for the CAD claw. Do not hand-edit;
     regenerate with grab_sequence/scripts/mesh_to_collision.py.
     Boxes, not the mesh, because a concave mesh collision is convex-hulled
     by the physics engine, which fills the grip pocket in and silently turns
     the wrap into a flat paddle. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

